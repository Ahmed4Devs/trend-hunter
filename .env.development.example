# =============================================================================
# TrendHunter — local development environment
# =============================================================================
# Copy to `.env` and you are done:
#
#   cp .env.development.example .env
#   pnpm docker:up
#   pnpm db:migrate && pnpm db:seed
#   pnpm dev
#
# Every credential here is an obvious fake. The whole product — collection,
# scoring, clustering, translation, the Content Studio — runs end to end on
# these values with no paid API and no network access to any provider.
#
# These values are deliberately rejected by the production environment
# validator, so this file can never be promoted to a live deployment by
# accident.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# API service
# -----------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# The Next.js dev server runs on a different origin than the API, so it has to
# be named explicitly for cookies and CORS to work.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Swagger UI at http://localhost:4000/docs
ENABLE_API_DOCS=true

RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=50
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_RATE_LIMIT_MAX=200
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60

TRUST_PROXY=false
MAX_BODY_BYTES=524288

# Lets the RSS connector reach a fixture server on your own machine.
# Refused outright when NODE_ENV=production.
ALLOW_PRIVATE_NETWORK_FETCH=true

# Seeds demo@trendhunter.local / TrendHunter123!
ENABLE_DEMO_ACCOUNT=true

# -----------------------------------------------------------------------------
# Datastores — provided by `pnpm docker:up`
# -----------------------------------------------------------------------------
# Use localhost when running the apps on the host, and the service names
# (postgres / redis) when running them inside Docker Compose.
DATABASE_URL=postgresql://trendhunter:trendhunter_dev@localhost:5432/trendhunter?schema=public
REDIS_URL=redis://localhost:6379

POSTGRES_DB=trendhunter
POSTGRES_USER=trendhunter
POSTGRES_PASSWORD=trendhunter_dev

# Host ports published by docker-compose.yml. Change these (and the two URLs
# above) if you already run PostgreSQL or Redis on the default ports.
POSTGRES_PORT=5432
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Authentication — development-only secret
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=mock_better_auth_secret_dev_only_change_me_0123456789
BETTER_AUTH_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Data collection and AI — fully offline
# -----------------------------------------------------------------------------
DATA_MODE=mock
AI_PROVIDER=mock
AI_MODEL=trendhunter-mock-v1
EMBEDDING_DIMENSIONS=768

# Obviously fake. Present only so the code paths that read them are exercised.
LLM_API_KEY=mock_llm_api_key_dev_only
X_API_BEARER_TOKEN=mock_x_api_bearer_token_dev_only
REDDIT_CLIENT_ID=mock_reddit_client_id_dev_only
REDDIT_CLIENT_SECRET=mock_reddit_client_secret_dev_only
GITHUB_TOKEN=mock_github_token_dev_only

# -----------------------------------------------------------------------------
# Worker service
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=2
ENABLE_SCHEDULED_SCANS=true
# Multiplies every scan interval so a laptop is not scanning every minute.
SCAN_INTERVAL_MULTIPLIER=4
RAW_ITEM_RETENTION_DAYS=30
JOB_RUN_RETENTION_DAYS=14
HEALTH_PORT=4001

# -----------------------------------------------------------------------------
# Web application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en
API_INTERNAL_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# End-to-end tests  (see docs/testing.md)
# -----------------------------------------------------------------------------
# Where the browser tests point. The port here is also the port Playwright
# starts the web server on, so one value moves both. If you change it, start the
# API with a matching APP_URL — it builds its CORS allowlist from that.
E2E_BASE_URL=http://127.0.0.1:3000
# The account they sign in as. Empty means the seeded demo account.
E2E_EMAIL=
E2E_PASSWORD=
