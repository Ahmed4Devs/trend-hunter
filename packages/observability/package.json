{
  "name": "@trendhunter/observability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pino logger factory with redaction, plus timing helpers.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
