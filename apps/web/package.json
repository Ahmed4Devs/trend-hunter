    "next-intl": "catalog:next16",
    "next-themes": "catalog:next16",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "recharts": "catalog:ui",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:next16",
    "@trendhunter/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "babel-plugin-react-compiler": "catalog:next16",
    "eslint": "catalog:",
