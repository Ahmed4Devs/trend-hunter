{
  "name": "@trendhunter/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TrendHunter Next.js application.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
