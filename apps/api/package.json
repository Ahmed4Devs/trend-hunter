{
  "name": "@trendhunter/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TrendHunter Fastify REST API.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/request-context": "catalog:",
    "@fastify/sensible": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@fastify/under-pressure": "catalog:",
    "@trendhunter/ai": "workspace:*",
    "@trendhunter/auth": "workspace:*",
    "@trendhunter/content": "workspace:*",
    "@trendhunter/database": "workspace:*",
    "@trendhunter/embeddings": "workspace:*",
    "@trendhunter/env": "workspace:*",
    "@trendhunter/observability": "workspace:*",
    "@trendhunter/ranking": "workspace:*",
    "@trendhunter/search": "workspace:*",
    "@trendhunter/shared": "workspace:*",
    "@trendhunter/translation": "workspace:*",
    "@trendhunter/types": "workspace:*",
    "@trendhunter/validation": "workspace:*",
    "bullmq": "catalog:",
    "close-with-grace": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "ioredis": "catalog:",
    "openapi-types": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@trendhunter/config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
