# =============================================================================
# TrendHunter — environment template
# =============================================================================
# Copy this file to `.env` and replace every value. `.env` is git-ignored.
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL. Every value below is either a
# placeholder or a safe local default. The production environment validator in
# `packages/env` refuses to start when it finds a value that still looks like a
# placeholder (see DEVELOPMENT_PLACEHOLDER_MARKERS), so a forgotten variable
# fails the deployment instead of quietly weakening it.
#
# Generate real secrets with:
#   openssl rand -base64 48
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# Public origin of the web app, and the origin browsers use to reach the API.
# In the recommended same-origin production layout both are the same host and
# Caddy routes /api/* to the API container.
APP_URL=https://trendhunter.example.com
API_URL=https://trendhunter.example.com

# -----------------------------------------------------------------------------
# API service
# -----------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Extra browser origins allowed by CORS, comma separated. Leave empty when the
# web app and the API share an origin. NEVER use "*" for an authenticated API.
CORS_ALLOWED_ORIGINS=

# The OpenAPI explorer is disabled in production by default.
ENABLE_API_DOCS=false

# Rate limits (requests per window, per client).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_RATE_LIMIT_MAX=30
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60

# Only enable behind a proxy you control (Caddy in this deployment).
TRUST_PROXY=true

# Maximum accepted request body, in bytes.
MAX_BODY_BYTES=524288

# SSRF guard. Must stay false in production; the validator enforces it.
ALLOW_PRIVATE_NETWORK_FETCH=false

# The demo account has a published password. Must stay false in production.
ENABLE_DEMO_ACCOUNT=false

# -----------------------------------------------------------------------------
# Datastores  (never expose these ports publicly — see docker-compose.production.yml)
# -----------------------------------------------------------------------------
# Use a dedicated, non-superuser database role for the application.
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@postgres:5432/trendhunter?schema=public&connection_limit=10
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379

# Consumed by docker-compose.production.yml to initialise the containers.
POSTGRES_DB=trendhunter
POSTGRES_USER=REPLACE_DB_USER
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_48_BYTE_BASE64_SECRET
BETTER_AUTH_URL=https://trendhunter.example.com

# -----------------------------------------------------------------------------
# Data collection and AI
# -----------------------------------------------------------------------------
# mock = deterministic offline connectors; live = real provider APIs.
DATA_MODE=mock

# mock = deterministic offline provider, requires no API key and costs nothing.
AI_PROVIDER=mock
AI_MODEL=trendhunter-mock-v1
# AI_BASE_URL=https://api.example-llm-provider.com/v1

# Embedding width. Changing this requires a migration: the pgvector columns are
# declared as vector(768) and the HNSW indexes are built for that width.
EMBEDDING_DIMENSIONS=768

# Provider credentials. Only needed when DATA_MODE=live / AI_PROVIDER != mock.
LLM_API_KEY=
X_API_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Worker service
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=4
ENABLE_SCHEDULED_SCANS=true
SCAN_INTERVAL_MULTIPLIER=1
RAW_ITEM_RETENTION_DAYS=90
JOB_RUN_RETENTION_DAYS=30
HEALTH_PORT=4001

# -----------------------------------------------------------------------------
# Web application  (NEXT_PUBLIC_* values are compiled into the browser bundle —
# never put a secret behind one of these names)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://trendhunter.example.com
NEXT_PUBLIC_API_URL=https://trendhunter.example.com
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Origin used by Server Components to reach the API over the internal Docker
# network, bypassing the public proxy.
API_INTERNAL_URL=http://api:4000

# -----------------------------------------------------------------------------
# Deployment  (consumed by docker-compose.production.yml and the Caddyfile)
# -----------------------------------------------------------------------------
DOMAIN=trendhunter.example.com
ACME_EMAIL=ops@example.com

# -----------------------------------------------------------------------------
# End-to-end tests  (see docs/testing.md)
# -----------------------------------------------------------------------------
# Where the browser tests point. Set this to run against an already-running
# instance, or to move off a busy port.
E2E_BASE_URL=http://127.0.0.1:3000
# The account they sign in as. Defaults to the seeded demo account.
E2E_EMAIL=
E2E_PASSWORD=
